PORT=4000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
HOOK_API_KEY=
AUTO_NOTE_FROM_TRANSCRIPT=true
AUTH_REQUIRED=true
AUTH_SECRET=change-me-in-production
ADMIN_EMAIL=admin@mom.local
ADMIN_PASSWORD=admin12345
DATA_DIR=./data
JOB_WORKER_INTERVAL_MS=2000
EMAIL_JOB_MAX_RETRIES=3

# ─── AI Provider (choose one) ───────────────────────────────────────────────
# AI_PROVIDER=groq     (default — fast Whisper audio + LLaMA text)
# AI_PROVIDER=gemini   (Google Gemini 2.0 Flash — native audio understanding)

AI_PROVIDER=groq

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=
# Override default text model (llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# Override Whisper model (whisper-large-v3-turbo)
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Override default Gemini model (gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
